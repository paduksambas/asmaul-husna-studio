{
  "name": "Asmaul Husna Studio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Asmaul Husna Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash -lc 'if ! pgrep -f "python3 -m http.server 8000" >/dev/null; then nohup python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/asmaul-husna-http.log 2>&1 & fi'",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
